            {{entityVar}}.{{StatusProp}}Localization = (({{StatusEnum}})request.{{NewCodeProp}}).GetDisplayName();
            {{entityVar}}.ModificationDate = DateTime.UtcNow;
            {{entityVar}}.ModifierName = _authenticatedUserService.{{UserNameMethod}}() ?? "System";

